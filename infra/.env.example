# Settings of the production/staging stack (infra/docker-compose.prod.yml). Copy to infra/.env and fill in.
# infra/.env is git-ignored: never commit it. On the server: chmod 600. Instructions: infra/DEPLOY.md.
# Generate secrets with: openssl rand -hex 32  (hex needs no escaping inside the Mongo URI)

# --- Docker (read by docker compose, not by the app) ------------------------------------------------------------
# Images: built here with --build (prefix nashi-v2, tag local) or pulled from a registry the pipeline publishes to,
# e.g. DEPLOY_IMAGE_PREFIX=ghcr.io/<owner>/nashi-v2 and DEPLOY_IMAGE_TAG=<git sha>
DEPLOY_IMAGE_PREFIX=nashi-v2
DEPLOY_IMAGE_TAG=local
# The host nginx proxies the domain to 127.0.0.1:<this port>
DEPLOY_WEB_PORT=4174
# Empty = AWS S3 (or another external S3). "minio" = run MinIO in this stack (then also set NASHI_S3_ENDPOINT below).
COMPOSE_PROFILES=
DEPLOY_MINIO_PORT=9100
# Mongo superuser, created on the first start of an empty volume (changing it later does not change the user)
MONGO_ROOT_USERNAME=nashi
MONGO_ROOT_PASSWORD=

# --- Backend: required (StartupConfigGuard refuses to start without them) ---------------------------------------
# Same user and password as above; host "mongo" is the compose service
SPRING_MONGODB_URI=mongodb://nashi:<MONGO_ROOT_PASSWORD>@mongo:27017/nashi_v2?authSource=admin
NASHI_S3_BUCKET=
NASHI_S3_REGION=eu-north-1
NASHI_S3_ACCESS_KEY_ID=
NASHI_S3_SECRET_ACCESS_KEY=
# Public address of the bucket for photos in the browser (only the artists/ prefix must be publicly readable),
# e.g. https://<bucket>.s3.<region>.amazonaws.com or a CDN in front of it
NASHI_S3_PUBLIC_BASE_URL=
# A NEW bot for V2 from @BotFather (never the V1 production bot: two apps polling one bot steal each other's updates)
NASHI_TELEGRAM_BOT_TOKEN=
# Moderation group id, negative: -100…
NASHI_TELEGRAM_MODERATION_CHAT_ID=
# openssl rand -hex 32; keep it stable (likes rate limits key on the hashed IP)
NASHI_SECURITY_IP_HASH_SECRET=
# The site address, without a trailing slash
NASHI_SITE_BASE_URL=https://<domain>
NASHI_CORS_ALLOWED_ORIGINS=https://<domain>
# Wikimedia asks bots for a working contact URL
NASHI_HTTP_USER_AGENT=NashiBot/2.0 (+https://<domain>/about)

# --- Backend: optional ------------------------------------------------------------------------------------------
# S3-compatible server instead of AWS (MinIO: http://minio:9000 with path-style access)
#NASHI_S3_ENDPOINT=
#NASHI_S3_PATH_STYLE_ACCESS=false
# Forum topic for moderation messages; who may press the buttons: CHAT_ADMINS (default) or ANY_MEMBER
#NASHI_TELEGRAM_MODERATION_THREAD_ID=
#NASHI_TELEGRAM_MODERATION_APPROVER_POLICY=CHAT_ADMINS
# Telegram is on by default in production; false switches the bot off (no moderation)
#NASHI_TELEGRAM_POLLING_ENABLED=true
#NASHI_TELEGRAM_SENDING_ENABLED=true
# Wikipedia import: keep off until the V1 migration has run (/migrate_v1 run), then turn on (monthly + /wiki_import)
NASHI_WIKI_IMPORT_ENABLED=false
#NASHI_WIKI_IMPORT_ON_STARTUP=false
#NASHI_WIKI_IMPORT_LIMIT_PER_GROUP=0
# Preview audio from Deezer / Apple: only after the legal OK for their terms
#NASHI_AUDIO_PROVIDERS_DEEZER_ENABLED=false
#NASHI_AUDIO_PROVIDERS_ITUNES_ENABLED=false

# --- One-off V1 migration (/migrate_v1 dry, then /migrate_v1 run); remove after the cutover --------------------
#NASHI_MIGRATION_V1_MONGO_URI=mongodb://<user>:<password>@<v1-host>:27017/nashi?authSource=admin
#NASHI_MIGRATION_V1_S3_BUCKET=
#NASHI_MIGRATION_V1_S3_REGION=eu-north-1
#NASHI_MIGRATION_V1_S3_ACCESS_KEY_ID=
#NASHI_MIGRATION_V1_S3_SECRET_ACCESS_KEY=
