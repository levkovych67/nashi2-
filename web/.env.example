# API base (default /api/v2). In dev, /api is proxied to VITE_DEV_API_PROXY.
VITE_API_BASE_URL=/api/v2
# Local backend for the Vite dev proxy (infra/docker-compose.yml)
VITE_DEV_API_PROXY=http://127.0.0.1:8081
# 1 = serve API from MSW fixtures in the browser
VITE_API_MOCK=
VITE_MAP_TILES_URL=https://tiles.openfreemap.org/planet
VITE_MAP_GLYPHS_URL=
# blank = background-only map style (offline E2E)
VITE_MAP_STYLE=
