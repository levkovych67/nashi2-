{
  "ci": {
    "collect": {
      "startServerCommand": "VITE_MAP_STYLE=blank npx vite build --outDir dist-lhci --emptyOutDir && node scripts/lhci-server.mjs",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/m/okean-elzy",
        "http://127.0.0.1:4173/suggest"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://[^/]+/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.7
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(m/[^/]+|suggest)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
